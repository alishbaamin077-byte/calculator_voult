<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="20dp"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔒 Private Vault"
            android:textColor="#BB86FC"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnChangePin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#333333"
            android:text="Change PIN"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginBottom="16dp" />

    <!-- Items List container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/vaultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Photos -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPhotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E1E1E"
                android:drawableStart="@android:drawable/ic_menu_gallery"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="Photos (0)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp" />

            <!-- Secret Note -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E1E1E"
                android:drawableStart="@android:drawable/ic_menu_edit"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="Secret Note (0)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp" />

            <!-- Apps -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E1E1E"
                android:drawableStart="@android:drawable/ic_menu_manage"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="Apps (0)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp" />

            <!-- Documents -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDocuments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E1E1E"
                android:drawableStart="@android:drawable/ic_menu_send"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="Documents (0)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Add item button -->
    <Button
        android:id="@+id/btnAddItem"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#BB86FC"
        android:text="+ Add Item"
        android:textColor="#000000"
        android:textStyle="bold" />

</LinearLayout>
