<resources>
    <style name="Theme.Calc" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/desk_bg</item>
        <item name="android:statusBarColor">#E9DAE7</item>
        <item name="android:navigationBarColor">#CDB4CB</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="KeyLook">
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:shadowColor">#66000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1.5</item>
        <item name="android:shadowRadius">1.5</item>
    </style>

    <style name="KeyRow" parent="KeyLook">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
    </style>

    <style name="KeyCol" parent="KeyLook">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
    </style>

    <style name="KeyRowBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>
</resources>